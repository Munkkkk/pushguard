{
  "description": "Blocks git push until the outgoing commits have passed a pushguard security review",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
