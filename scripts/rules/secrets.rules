# pushguard secret rules
# Format (whitespace separated): id  severity  flags  regex  description...
#   flags: i = case-insensitive, - = none
#   regex: POSIX ERE (grep -E). It must not contain a space or tab: use [[:space:]].
# CRITICAL/HIGH rules block the push gate. MEDIUM rules are leads the reviewer must judge.

aws-access-key-id      CRITICAL -  (AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}                                         AWS access key ID
aws-secret-access-key  CRITICAL i  aws.{0,24}(secret|sk).{0,24}["'][0-9a-zA-Z/+]{40}["']                     AWS secret access key
private-key-block      CRITICAL -  -----BEGIN[[:space:]]([A-Z]+[[:space:]])?PRIVATE[[:space:]]KEY            Private key (PEM)
github-token           CRITICAL -  gh[pousr]_[A-Za-z0-9]{36,}                                                GitHub token
github-fine-grained    CRITICAL -  github_pat_[A-Za-z0-9_]{60,}                                              GitHub fine-grained token
gitlab-token           CRITICAL -  glpat-[A-Za-z0-9_-]{20,}                                                  GitLab personal access token
stripe-live-key        CRITICAL -  (sk|rk)_live_[0-9a-zA-Z]{20,}                                             Stripe live secret key
stripe-webhook-secret  HIGH     -  whsec_[A-Za-z0-9]{24,}                                                    Stripe webhook signing secret
anthropic-key          CRITICAL -  sk-ant-[A-Za-z0-9_-]{24,}                                                 Anthropic API key
openai-key             CRITICAL -  sk-(proj-|svcacct-|admin-)?[A-Za-z0-9_-]{40,}                             OpenAI-style API key
google-api-key         HIGH     -  AIza[0-9A-Za-z_-]{35}                                                     Google API key (check its restrictions)
google-oauth-secret    CRITICAL -  GOCSPX-[A-Za-z0-9_-]{20,}                                                 Google OAuth client secret
gcp-service-account    CRITICAL -  "type"[[:space:]]*:[[:space:]]*"service_account"                          GCP service account key file
azure-storage-key      CRITICAL -  AccountKey=[A-Za-z0-9+/=]{60,}                                            Azure storage account key
slack-token            CRITICAL -  xox[baprs]-[A-Za-z0-9-]{10,}                                              Slack token
slack-webhook          HIGH     -  hooks\.slack\.com/services/T[A-Za-z0-9_]+/B[A-Za-z0-9_]+/[A-Za-z0-9_]+    Slack incoming webhook URL
discord-webhook        HIGH     -  discord(app)?\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+                     Discord webhook URL
sendgrid-key           CRITICAL -  SG\.[A-Za-z0-9_-]{22}\.[A-Za-z0-9_-]{43}                                  SendGrid API key
twilio-key             HIGH     -  SK[0-9a-f]{32}                                                            Twilio API key
resend-key             HIGH     -  re_[A-Za-z0-9]{8,}_[A-Za-z0-9]{20,}                                       Resend API key
npm-token              CRITICAL -  npm_[A-Za-z0-9]{36}                                                       npm access token
pypi-token             CRITICAL -  pypi-AgEIcHlwaS5vcmc[A-Za-z0-9_-]{50,}                                    PyPI upload token
huggingface-token      HIGH     -  hf_[A-Za-z0-9]{34,}                                                       Hugging Face token
digitalocean-token     CRITICAL -  do[por]_v1_[a-f0-9]{64}                                                   DigitalOcean token
shopify-token          CRITICAL -  shp(at|ca|pa|ss)_[a-fA-F0-9]{32}                                          Shopify token
telegram-bot-token     HIGH     -  [0-9]{8,10}:AA[A-Za-z0-9_-]{33}                                           Telegram bot token
supabase-secret-key    CRITICAL -  sb_secret_[A-Za-z0-9_-]{20,}                                              Supabase secret key
vercel-token           HIGH     -  vc[pkiar]_[A-Za-z0-9]{24,}                                                Vercel token
db-url-with-password   HIGH     i  (postgres(ql)?|mysql|mariadb|mongodb(\+srv)?|rediss?|amqps?|mssql)://[^:@/[:space:]"'<>$]+:[^@/[:space:]"'<>${]+@   Database URL with embedded password
basic-auth-url         MEDIUM   i  https?://[^:@/[:space:]"'<>$]+:[^@/[:space:]"'<>${]+@[a-z0-9]             URL with embedded credentials
jwt-literal            MEDIUM   -  eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}          Hardcoded JWT (a Supabase service_role key or a session token is critical; an anon key is not)
generic-secret-assign  MEDIUM   i  (api[_-]?key|secret|token|passw(or)?d|pwd|private[_-]?key|client[_-]?secret|auth[_-]?key)[a-z0-9_]*["']?[[:space:]]*[:=][[:space:]]*["'][A-Za-z0-9+/_=.-]{16,}["']   Hardcoded value assigned to a secret-looking name
